# Merge these keys into backend/.env on the future Windows server.
# Local pilot can use instant registration without email delivery.
SAAS_ENABLED=false
SAAS_REGISTRATION_ENABLED=false
SAAS_REGISTRATION_MODE=instant
# For local pilot, enable this to provision stores inside the API process.
# Windows services can use the separate worker instead.
SAAS_EMBEDDED_WORKER=false
FB_DATABASE=D:/Garage/garage-app/backend/GARAGE.FDB
SAAS_DATA_ROOT=D:/Garage/garage-app/backend/saas
SAAS_PLATFORM_DATABASE=D:/Garage/garage-app/backend/saas/platform-v1.fdb
SAAS_LEGACY_CODE=kazuko
SAAS_TRIAL_DAYS=14
SAAS_MAX_POOLS=20
API_BIND_HOST=127.0.0.1
SAAS_PUBLIC_URL=
SAAS_TERMS_URL=
SAAS_PRIVACY_URL=
# HTTPS provider webhook accepting {to,subject,text}, success HTTP 2xx.
SAAS_MAIL_WEBHOOK=
SAAS_MAIL_TOKEN=
# scrypt password hash, never a plaintext password; see deployment guide.
SAAS_ADMIN_PASSWORD_HASH=
# Optional paths to tools on the hosting server.
FB_ISQL=C:/Program Files/Firebird/Firebird_2_5/bin/isql.exe
FB_GBAK=C:/Program Files/Firebird/Firebird_2_5/bin/gbak.exe
