{
  "name": "garage-app-backend",
  "version": "1.0.0",
  "description": "Backend Express + Firebird 2.5 cho He thong quan ly gara oto",
  "main": "src/server.js",
  "scripts": {
    "test:employee-compensation": "node --test --test-concurrency=1 tests/employeeCompensation*.test.js",
    "migrate:employee-profiles": "node migrate_employee_profiles.js",
    "migrate:repair-commissions": "node migrate_repair_commissions.js",
    "test:repair-commissions": "node --test --test-concurrency=1 tests/repairCommissions*.test.js",
    "migrate:finance-accounts": "node migrate_finance_accounts.js",
    "migrate:applied-charge-rates": "node migrate_applied_charge_rates.js",
    "migrate:default-charge-rates": "node migrate_default_charge_rates.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate:access": "node migrate_access_control.js",
    "migrate:document-numbers": "node migrate_document_numbers.js",
    "migrate:print-templates": "node migrate_print_templates.js D:/Garage/DATA.fdb",
