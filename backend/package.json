    "migrate:repair-line-discounts": "node migrate_repair_line_discounts.js",
    "migrate:bill-discount-amount": "node migrate_bill_discount_amount.js",
    "migrate:repair-provisional-print": "node migrate_repair_provisional_print.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "node-firebird": "^2.18.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
